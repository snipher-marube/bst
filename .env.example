# ══════════════════════════════════════════════════════════════════════════════
# AnalyticsMeta — Environment Variables
#
# Copy this file:  cp .env.example .env
# Then fill in every value before running the app.
#
# Rules for python-decouple:
#  • Do NOT put inline comments on the same line as a value.
#  • Booleans: True / False  (capital first letter)
#  • Empty optional values: leave blank (no quotes needed)
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# Django core
# ──────────────────────────────────────────────────────────────────────────────
# Generate a strong secret:  python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-secret-key

# development | production
DJANGO_SETTINGS_MODULE=config.settings.development

# Host ports published by docker-compose.dev.yml
# Change these if the defaults are already in use on your machine.
DEV_WEB_PORT=18000
DEV_POSTGRES_PORT=15433
DEV_REDIS_PORT=16380

# ──────────────────────────────────────────────────────────────────────────────
# Development database  (used by config.settings.development)
# When using Docker Compose: HOST = 'postgres' (service name)
# Manual install: HOST = 'localhost'
# ──────────────────────────────────────────────────────────────────────────────
PG_DATABASE_NAME_DEV=analyticsmeta
PG_DATABASE_USER_DEV=postgres
PG_DATABASE_PASSWORD_DEV=postgres
PG_DATABASE_HOST_DEV=localhost
PG_DATABASE_PORT_DEV=5432

# ──────────────────────────────────────────────────────────────────────────────
# Production database  (used by config.settings.production)
# On Render: copy values from Dashboard → your DB → Connection tab
# ──────────────────────────────────────────────────────────────────────────────
PG_DATABASE_NAME=analyticsmeta_prod
PG_DATABASE_USER=analyticsmeta_user
PG_DATABASE_PASSWORD=strong-password-here
PG_DATABASE_HOST=dpg-xxxx.oregon-postgres.render.com
PG_DATABASE_PORT=5432

# ──────────────────────────────────────────────────────────────────────────────
# Redis
# Dev:        redis://localhost:6379/0   (or redis://redis:6379/0 with Docker)
# Production: rediss://:password@host:6380  (Upstash TLS URL)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=localhost
REDIS_PORT=6379

# ──────────────────────────────────────────────────────────────────────────────
# Email — Gmail SMTP
# Use an App Password, not your Gmail login password.
# Guide: https://support.google.com/accounts/answer/185833
# ──────────────────────────────────────────────────────────────────────────────
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
SUPPORT_EMAIL=support@analyticsmeta.com
SALES_EMAIL=sales@analyticsmeta.com
PHONE_NUMBER=+254 700 000 000
ADDRESS=Nairobi, Kenya

# ──────────────────────────────────────────────────────────────────────────────
# Site settings
# ──────────────────────────────────────────────────────────────────────────────
SITE_NAME=AnalyticsMeta
SITE_URL=http://localhost:8000

# Comma-separated — no spaces. Production example:
# ALLOWED_HOSTS=analyticsmeta.onrender.com,analyticsmeta.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ──────────────────────────────────────────────────────────────────────────────
# Admin error notifications (production only)
# Errors at WARNING+ are emailed to this address via django.utils.log.AdminEmailHandler
# ──────────────────────────────────────────────────────────────────────────────
ADMIN_NAME=Snipher Marube
ADMIN_EMAIL=sniphermarube@gmail.com

# ──────────────────────────────────────────────────────────────────────────────
# Google OAuth 2.0
# Console: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI to add:
#   http://localhost:8000/accounts/google/login/callback/       (dev)
#   https://yourdomain.com/accounts/google/login/callback/     (prod)
# ──────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# LinkedIn OAuth 2.0
# Console: https://www.linkedin.com/developers/apps
# Authorised redirect URI to add:
#   http://localhost:8000/accounts/linkedin_oauth2/login/callback/       (dev)
#   https://yourdomain.com/accounts/linkedin_oauth2/login/callback/     (prod)
# ──────────────────────────────────────────────────────────────────────────────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# M-Pesa Daraja API
# Portal: https://developer.safaricom.co.ke
#
# SANDBOX (safe defaults are already in base.py — only set these to override)
# MPESA_SANDBOX=True uses KES 1 test amount automatically.
# ──────────────────────────────────────────────────────────────────────────────
MPESA_SANDBOX=True
MPESA_CONSUMER_KEY=your-daraja-consumer-key
MPESA_CONSUMER_SECRET=your-daraja-consumer-secret

# Sandbox public shortcode and passkey (pre-filled in base.py — override here):
MPESA_SHORTCODE=174379
MPESA_PASSKEY=bfb279f9aa9bdbcf158e97dd71a467cd2e0c893059b10f78e6b72ada1ed2c919

# Must be a publicly reachable HTTPS URL.
# Local dev: use ngrok — e.g. https://abc123.ngrok.io/subscriptions/mpesa/callback/
MPESA_CALLBACK_URL=https://your-ngrok-url.ngrok.io/subscriptions/mpesa/callback/

# ──────────────────────────────────────────────────────────────────────────────
# Redis (extra)
# ──────────────────────────────────────────────────────────────────────────────
REDIS_DB=0

# ──────────────────────────────────────────────────────────────────────────────
# Stripe (optional — webhook handler is present but not yet active)
# ──────────────────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# Twilio — WhatsApp alert delivery
# Console: https://console.twilio.com
# In sandbox: users must join the sandbox first (reply "join <code>" to +14155238886)
# ──────────────────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Sandbox default: whatsapp:+14155238886 — replace with your approved number in prod
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# ──────────────────────────────────────────────────────────────────────────────
# Claude / Anthropic
# ──────────────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
CLAUDE_INSIGHT_MODEL=claude-sonnet-4-6
LLM_WORKSPACE_MONTHLY_TOKEN_BUDGET=100000

# ──────────────────────────────────────────────────────────────────────────────
# SSO / SAML (optional — only needed when configuring a SAML Identity Provider)
# Generate SP key+cert:
#   openssl req -x509 -newkey rsa:2048 -keyout sp.key -out sp.crt -days 3650 -nodes
# Paste the base64 body (no PEM headers) below.
# ──────────────────────────────────────────────────────────────────────────────
SAML_SP_CERT=
SAML_SP_KEY=

# ──────────────────────────────────────────────────────────────────────────────
# Sentry — error tracking (optional)
# ──────────────────────────────────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
DJANGO_ENV=development
GIT_COMMIT=

# ──────────────────────────────────────────────────────────────────────────────
# Query engine & import tuning (safe to leave at defaults)
# ──────────────────────────────────────────────────────────────────────────────
QUERY_ENGINE_MAX_RECORDS=10000
QUERY_ENGINE_PROFILE_SAMPLE=1000
IMPORT_BATCH_SIZE=200
WIDGET_CACHE_TTL=300
MAX_IMPORT_FILE_BYTES=52428800
AUDIT_LOG_RETENTION_DAYS=90

# ──────────────────────────────────────────────────────────────────────────────
# WebSocket limits
# ──────────────────────────────────────────────────────────────────────────────
WS_RATE_LIMIT_WINDOW=10
WS_RATE_LIMIT_MAX_MSGS=30
WS_HEARTBEAT_TIMEOUT=90
WS_MAX_CONNECTIONS_PER_USER=200

# ──────────────────────────────────────────────────────────────────────────────
# Cloudinary CDN — static files & media uploads in production
# Get credentials from https://cloudinary.com/console
# ──────────────────────────────────────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
