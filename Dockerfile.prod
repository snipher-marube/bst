# ══════════════════════════════════════════════════════════════════════════════
# Stage 1 — builder: install Python deps into an isolated venv
# ══════════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
        gcc \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv (fast pip replacement)
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

WORKDIR /build

# Copy only dependency manifests first — maximises layer-cache hits
COPY pyproject.toml uv.lock README.md ./

# Create venv and install production deps only (no dev extras)
RUN uv venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"
RUN uv pip install -e . --no-dev

# ══════════════════════════════════════════════════════════════════════════════
# Stage 2 — runtime: minimal image, no build tools, non-root user
# ══════════════════════════════════════════════════════════════════════════════
FROM python:3.14-slim-bookworm AS runtime

# Runtime-only system packages
RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user/group
RUN groupadd --system --gid 1001 appgroup \
 && useradd  --system --uid 1001 --gid appgroup --no-create-home appuser

WORKDIR /app

# Copy venv from builder — no compiler toolchain in the final image
COPY --from=builder /opt/venv /opt/venv
ENV VIRTUAL_ENV=/opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Copy application source (owned by appuser so runtime writes work)
COPY --chown=appuser:appgroup . .

# Create writable dirs
RUN mkdir -p /app/logs /app/staticfiles /app/static/media \
 && chown -R appuser:appgroup /app/logs /app/staticfiles /app/static/media

USER appuser

# Python tuning
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONFAULTHANDLER=1 \
    PYTHONHASHSEED=random \
    DJANGO_SETTINGS_MODULE=config.settings.production

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8000/health/ || exit 1

ENTRYPOINT ["/app/entrypoint.sh"]
CMD ["daphne", "-b", "0.0.0.0", "-p", "8000", "config.asgi:application"]
